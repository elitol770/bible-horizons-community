{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elitol770/bible-horizons-community/schemas/scene.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "scope",
    "status",
    "passage",
    "summary",
    "limitations",
    "evidenceKind",
    "model",
    "files",
    "views",
    "hotspots",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scope": {
      "enum": ["asset", "chapter"]
    },
    "status": {
      "enum": ["example", "proposal"]
    },
    "passage": {
      "$ref": "#/$defs/passage"
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "limitations": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "evidenceKind": {
      "enum": [
        "textual_depiction",
        "material_evidence",
        "scholarly_reconstruction",
        "tradition",
        "artistic_interpretation"
      ]
    },
    "model": {
      "type": "string",
      "pattern": "^assets/[a-zA-Z0-9_/-]+\\.glb$",
      "maxLength": 160
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "position", "target"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "position": {
            "$ref": "#/$defs/vector"
          },
          "target": {
            "$ref": "#/$defs/vector"
          }
        }
      }
    },
    "hotspots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "position",
          "description",
          "verseStart",
          "verseEnd",
          "evidenceKind",
          "sourceUrl"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "position": {
            "$ref": "#/$defs/vector"
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          },
          "verseStart": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "verseEnd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "evidenceKind": {
            "enum": [
              "textual_depiction",
              "material_evidence",
              "scholarly_reconstruction",
              "tradition",
              "artistic_interpretation"
            ]
          },
          "sourceUrl": {
            "$ref": "#/$defs/url"
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verseStart", "verseEnd", "treatment", "description"],
        "properties": {
          "verseStart": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "verseEnd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "treatment": {
            "enum": ["scene", "object", "supporting_context"]
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 600
    },
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "book",
        "chapter",
        "verseStart",
        "verseEnd",
        "edition",
        "sourceUrl"
      ],
      "properties": {
        "book": {
          "type": "string",
          "pattern": "^[A-Z0-9]{3}$"
        },
        "chapter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "verseStart": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "verseEnd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "edition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceUrl": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "creator",
        "license",
        "changes",
        "provenance"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/[a-zA-Z0-9_/-]+\\.(glb|png|jpg|webp|txt)$",
          "maxLength": 160
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "creator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "license": {
          "enum": ["CC-BY-4.0", "CC0-1.0"]
        },
        "changes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source", "rightsEvidence"],
          "properties": {
            "kind": {
              "enum": ["original", "third_party", "generated"]
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "rightsEvidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1500
            },
            "tool": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "generatedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "generated"
                  }
                }
              },
              "then": {
                "required": ["tool", "generatedAt"],
                "properties": {
                  "tool": {},
                  "generatedAt": {}
                }
              }
            }
          ]
        }
      }
    }
  }
}
