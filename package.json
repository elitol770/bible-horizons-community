    "package:new": "node scripts/new-package.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "three": "0.187.0"
  },
