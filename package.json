{
  "name": "bible-horizons-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "validate": "node scripts/validate.mjs",
